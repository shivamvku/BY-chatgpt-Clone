    "format:check": "prettier --check src e2e *.ts",
    "lint": "eslint src e2e *.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.0",
