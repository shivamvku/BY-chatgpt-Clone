APP_ENV=development
DATABASE_URL=postgresql+psycopg://chat:local-development-only@localhost:25432/chat
SERVE_FRONTEND=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# Azure v1 base URL, e.g. https://your-resource.openai.azure.com/openai/v1
LLM_ENDPOINT=
LLM_MODEL=
# Optional development key; Azure deployment uses managed identity instead.
LLM_API_KEY=
DAILY_REQUESTS=30
DAILY_TOKEN_LIMIT=40000
GLOBAL_DAILY_TOKEN_LIMIT=100000
MAX_OUTPUT_TOKENS=1024
