APP_ENV=development
DATABASE_URL=postgresql+psycopg://chat:local-development-only@localhost:25432/chat
SERVE_FRONTEND=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
GEMINI_API_KEY=
# Catalogue IDs available for Gemini: gemini-3.5-flash, gemini-3.6-flash, gemini-3.7-flash
GROQ_API_KEY=
# Catalogue IDs available for Groq: groq-qwen3-27b, groq-gpt-oss-120b, groq-gpt-oss-20b
DAILY_REQUESTS=30
DAILY_TOKEN_LIMIT=40000
GLOBAL_DAILY_TOKEN_LIMIT=100000
MAX_OUTPUT_TOKENS=1024
