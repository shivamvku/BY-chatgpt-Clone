APP_ENV=development
DATABASE_URL=postgresql+psycopg://chat:local-development-only@localhost:25432/chat
SERVE_FRONTEND=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
GEMINI_API_KEY=
# GEMINI_MODEL is a legacy override; the model catalogue in provider.py owns
# model IDs. Working catalogue IDs: gemini-3.5-flash, gemini-3.6-flash,
# gemini-3.7-flash. Set this only if you need to override the default in tests.
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
# GROQ_MODEL is a legacy override; the catalogue owns model IDs.
# Catalogue IDs: groq-qwen3-27b, groq-gpt-oss-120b, groq-gpt-oss-20b.
GROQ_MODEL=qwen/qwen3.8-27b
DAILY_REQUESTS=30
DAILY_TOKEN_LIMIT=40000
GLOBAL_DAILY_TOKEN_LIMIT=100000
MAX_OUTPUT_TOKENS=1024
